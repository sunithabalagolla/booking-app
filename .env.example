# Talkies settings (SEC-07). Copy this file to .env and fill in the values.
# Never commit .env. Keep this file in git with empty secrets.

# Server
PORT=5000
# Client address, used for links in emails (verify email, reset password)
CLIENT_URL=http://localhost:5173

# Database: Docker MongoDB (single-node replica set rs0, needed for transactions) now; Atlas link in Phase 12
MONGODB_URI=mongodb://127.0.0.1:27017/talkies?replicaSet=rs0

# Login access token (BR-19, JWT) - a long random string, at least 32 characters.
# The refresh token is a random value stored hashed in the database, so it needs no secret.
JWT_ACCESS_SECRET=

# Signed QR tickets (SEC-09)
QR_SECRET=

# Mock payment (PAY-01): signing key of the fake gateway, like the Razorpay key secret.
# A long random string, at least 32 characters. The server does not start without it.
PAYMENT_SECRET=

# Email (Postmark). Empty = emails are printed in the server console
POSTMARK_API_KEY=
# Sender address checked in Postmark (needed only when POSTMARK_API_KEY is set)
EMAIL_FROM=

# Images (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Owner bank details encryption (SEC-12)
BANK_ENCRYPTION_KEY=

# Seed script (npm run seed): one password for all sample test logins (development only)
SEED_PASSWORD=
