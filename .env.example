# Talkies settings (SEC-07). Copy this file to .env and fill in the values.
# Never commit .env. Keep this file in git with empty secrets.

# Server
PORT=5000

# Database: Docker MongoDB on the laptop now; Atlas link in Phase 12
MONGODB_URI=mongodb://127.0.0.1:27017/talkies

# Login tokens (BR-19) - long random strings
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Signed QR tickets (SEC-09)
QR_SECRET=

# Email (Postmark). Empty = emails are printed in the server console
POSTMARK_API_KEY=

# Images (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Owner bank details encryption (SEC-12)
BANK_ENCRYPTION_KEY=
